# Copy to .env and fill in. Never commit .env.
# mock runs the full demo with no network and is the default.
# live calls Airwallex using the base URL below.
LEDGERLINE_MODE=mock

# demo -> https://api-demo.airwallex.com (default)
# sandbox -> https://api.sandbox.airwallex.com
# AIRWALLEX_BASE_URL overrides AIRWALLEX_ENV when both are set.
AIRWALLEX_ENV=demo
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com

# Required only when LEDGERLINE_MODE=live.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Webhook signing secret returned by POST /api/v1/webhooks/create (or the web app's
# Settings > Developer > Webhooks).
AIRWALLEX_WEBHOOK_SECRET=
# Global Account ids used by POST /simulation/deposit/create. Currency is the account's currency.
AIRWALLEX_GLOBAL_ACCOUNT_USD=
AIRWALLEX_GLOBAL_ACCOUNT_EUR=
AIRWALLEX_GLOBAL_ACCOUNT_GBP=
# Live only. ringfenced (default) plans on balance changes since the run started;
# wallet plans on the whole sandbox wallet. RUN_ID prefixes request ids.
LEDGERLINE_LIVE_BOOK=ringfenced
LEDGERLINE_RUN_ID=
# mock only: wall makes the mock console use real time (traces show real times).
LEDGERLINE_CLOCK=

# Model provider: offline (default), anthropic, or xai.
# offline needs no key. A missing key or model name stays on offline.
LEDGERLINE_MODEL_PROVIDER=offline
LEDGERLINE_MODEL=
ANTHROPIC_API_KEY=
XAI_API_KEY=

LEDGERLINE_LIMITS=policy/limits.yaml
LEDGERLINE_DATA_DIR=data
